    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "pytest hw1",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-s",
                "src/hw1_imitation/data_test.py::test_build_valid_indices"
            ],
            "cwd": "/Users/ly232/github/berkeley-deep-rl-sp26/hw1",
            "python": "/Users/ly232/github/berkeley-deep-rl-sp26/hw1/.venv/bin/python",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "HW2 CartPole debug",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/hw2/src/scripts/run.py",
            "cwd": "${workspaceFolder}/hw2",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/hw2/.venv/bin/python",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/hw2/src",
                "WANDB_MODE": "offline"
            },
            "args": [
                "--env_name", "CartPole-v0",
                "-n", "100",
                "-b", "1000",
                "--exp_name", "cartpole"
            ]
        }
    ]
}